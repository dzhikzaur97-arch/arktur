{
  "name": "rychag-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Рычаг — гид по тренажёрам (iOS и Android, Capacitor)",
  "scripts": {
    "build": "node scripts/build-www.js",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "assets": "npx capacitor-assets generate --iconBackgroundColor '#0c0d12' --iconBackgroundColorDark '#0c0d12' --splashBackgroundColor '#0c0d12' --splashBackgroundColorDark '#0c0d12'"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0"
  }
}
